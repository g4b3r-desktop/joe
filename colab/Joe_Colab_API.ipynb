    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "#@title Monitorar CPU, RAM, GPU e VRAM\n",
        "%pip install -q psutil gputil\n",
        "\n",
        "import psutil\n",
        "import time\n",
        "from IPython.display import clear_output\n",
        "import GPUtil\n",
        "\n",
        "def monitor_resources_loop(interval_seconds=2):\n",
        "    try:\n",
        "        while True:\n",
        "            clear_output(wait=True)\n",
        "            print(\"=== Monitoramento do Sistema (use o botão Parar [■] para interromper) ===\\n\")\n",
        "\n",
        "            # CPU\n",
        "            cpu_usage = psutil.cpu_percent()\n",
        "            cpu_cores = psutil.cpu_count()\n",
        "            print(f\"CPU: {cpu_usage}% (Total de Cores: {cpu_cores})\")\n",
        "\n",
        "            # RAM\n",
        "            ram = psutil.virtual_memory()\n",
        "            ram_total = ram.total / (1024**3)\n",
        "            ram_used = ram.used / (1024**3)\n",
        "            print(f\"RAM: {ram_used:.2f} GB / {ram_total:.2f} GB ({ram.percent}% em uso)\")\n",
        "\n",
        "            # GPU & VRAM\n",
        "            gpu_query_ok = True\n",
        "            try:\n",
        "                gpus = GPUtil.getGPUs()\n",
        "            except Exception as exc:\n",
        "                gpus = []\n",
        "                gpu_query_ok = False\n",
        "                print(f\"\\nGPU/VRAM: não foi possível consultar a GPU ({exc})\")\n",
        "\n",
        "            if gpus:\n",
        "                for i, gpu in enumerate(gpus):\n",
        "                    print(f\"\\n=== GPU {i}: {gpu.name} ===\")\n",
        "                    print(f\"Uso da GPU: {gpu.load*100:.1f}%\")\n",
        "                    print(f\"VRAM (Memória de Vídeo): {gpu.memoryUsed:.0f} MB / {gpu.memoryTotal:.0f} MB ({gpu.memoryUtil*100:.1f}% em uso)\")\n",
        "                    print(f\"Temperatura: {gpu.temperature:.0f}°C\")\n",
        "            elif gpu_query_ok:\n",
        "                print(\"\\nGPU/VRAM: nenhuma GPU ativa ou disponível neste ambiente de execução.\")\n",
        "\n",
        "            time.sleep(interval_seconds)\n",
        "    except KeyboardInterrupt:\n",
        "        print(\"\\nMonitoramento interrompido pelo usuário.\")\n",
        "\n",
        "# Inicia o monitoramento atualizando a cada 2 segundos\n",
        "monitor_resources_loop(interval_seconds=2)\n"
      ]
    },
