      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "#@title Iniciar a API do Joe e publicar o túnel\nimport os\nimport re\nimport secrets\nimport shutil\nimport subprocess\nimport sys\nimport threading\nimport time\nimport queue\nimport requests\nfrom pathlib import Path\nfrom IPython.display import display, Markdown\n\n# Impede iniciar a API se a configuração local do Drive não foi aplicada.\nif os.environ.get('JOE_TTS_USE_DRIVE_MODELS') != '1':\n    raise RuntimeError(\n        'Modelos do Pocket TTS do Google Drive não foram configurados. '\n        'Volte à célula Google Drive, corrija os arquivos e clique em Aplicar.'\n    )\nfor config_key in ('JOE_TTS_CONFIG_PATH', 'JOE_TTS_24L_CONFIG_PATH'):\n    config_value = os.environ.get(config_key)\n    if not config_value or not Path(config_value).is_file():\n        raise RuntimeError(\n            f'Arquivo YAML local do Pocket TTS não encontrado: {config_key}. '\n            'Reaplique a configuração do Drive.'\n        )\n\n# Reutiliza o token persistente do Colab Secrets. Só gera um token novo\n# quando JOE_API_TOKEN ainda não foi configurado.\nAPI_TOKEN = os.environ.get('JOE_API_TOKEN', '').strip()\nGENERATED_API_TOKEN = not bool(API_TOKEN)\nif GENERATED_API_TOKEN:\n    API_TOKEN = secrets.token_urlsafe(36)\nos.environ['JOE_API_TOKEN'] = API_TOKEN\n\n# Instala o binário oficial cloudflared para criar o túnel.\ncloudflared_path = shutil.which('cloudflared')\nif cloudflared_path is None:\n    binary = '/usr/local/bin/cloudflared'\n    subprocess.run(\n        ['wget', '-q', '-O', binary,\n         'https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64'],\n        check=True,\n    )\n    os.chmod(binary, 0o755)\n    cloudflared_path = binary\n\n# Libera a porta 8000 antes de iniciar uma nova instância da API.\nsubprocess.run(\n    ['bash', '-c', 'fuser -k 8000/tcp'],\n    capture_output=True,\n    text=True,\n)\ntime.sleep(2)\nprint('Porta 8000 liberada.')\n\nserver_process = subprocess.Popen(\n    [sys.executable, '-m', 'uvicorn', 'api_server:app',\n     '--host', '127.0.0.1', '--port', '8000', '--no-access-log'],\n    cwd='/content/joe/colab',\n    env=os.environ.copy(),\n    stdout=subprocess.PIPE,\n    stderr=subprocess.STDOUT,\n    text=True,\n    bufsize=1,\n)\n\n# Confirma que a API iniciou antes de publicar o túnel.\napi_ready = False\nfor _ in range(60):\n    if server_process.poll() is not None:\n        raise RuntimeError('O servidor Joe API terminou inesperadamente.')\n    try:\n        response = requests.get(\n            'http://127.0.0.1:8000/health',\n            headers={'Authorization': f'Bearer {API_TOKEN}'},\n            timeout=2,\n        )\n        if response.status_code == 200:\n            api_ready = True\n            break\n    except requests.RequestException:\n        pass\n    time.sleep(1)\nif not api_ready:\n    raise RuntimeError('A API não respondeu. Confira a saída do processo uvicorn.')\n\nJOE_TUNNEL_MODE = globals().get('JOE_TUNNEL_MODE', 'quick')\nJOE_TUNNEL_DOMAIN = globals().get('JOE_TUNNEL_DOMAIN', '')\nJOE_TUNNEL_TOKEN = globals().get('JOE_TUNNEL_TOKEN', '')\n\ntunnel_lines = queue.Queue()\ntunnel_env = os.environ.copy()\nif JOE_TUNNEL_MODE == 'custom':\n    if not JOE_TUNNEL_DOMAIN or not JOE_TUNNEL_TOKEN:\n        raise RuntimeError('Configure JOE_API_URL e CLOUDFLARE_TUNNEL_TOKEN nos Secrets ou na célula de configuração do túnel.')\n    API_URL = os.environ.get('JOE_API_URL', f'https://{JOE_TUNNEL_DOMAIN}').strip().rstrip('/')\n    if _domain_from_api_url(API_URL) != JOE_TUNNEL_DOMAIN:\n        raise RuntimeError('JOE_API_URL precisa corresponder ao domínio configurado no Named Tunnel.')\n    # TUNNEL_TOKEN evita expor o segredo nos argumentos do processo.\n    tunnel_env['TUNNEL_TOKEN'] = JOE_TUNNEL_TOKEN\n    tunnel_command = [cloudflared_path, 'tunnel', '--no-autoupdate', '--loglevel', 'info', 'run']\nelse:\n    tunnel_command = [\n        cloudflared_path, 'tunnel', '--url',\n        'http://127.0.0.1:8000', '--no-autoupdate'\n    ]\n    API_URL = None\n\ntunnel_process = subprocess.Popen(\n    tunnel_command,\n    stdout=subprocess.PIPE,\n    stderr=subprocess.STDOUT,\n    text=True,\n    bufsize=1,\n    env=tunnel_env,\n)\n\ndef _read_tunnel_output():\n    for line in tunnel_process.stdout:\n        tunnel_lines.put(line.rstrip())\n\nthreading.Thread(target=_read_tunnel_output, daemon=True).start()\n\nif JOE_TUNNEL_MODE == 'quick':\n    deadline = time.time() + 90\n    while time.time() < deadline and API_URL is None:\n        if tunnel_process.poll() is not None:\n            raise RuntimeError('O cloudflared terminou inesperadamente.')\n        try:\n            line = tunnel_lines.get(timeout=1)\n        except queue.Empty:\n            continue\n        match = re.search(r'https://[a-z0-9-]+\\.trycloudflare\\.com', line)\n        if match:\n            API_URL = match.group(0)\n    if not API_URL:\n        raise RuntimeError('Não foi possível obter a URL trycloudflare. Veja os logs do cloudflared.')\nelse:\n    time.sleep(5)\n    if tunnel_process.poll() is not None:\n        recent_logs = []\n        while not tunnel_lines.empty():\n            recent_logs.append(tunnel_lines.get_nowait())\n        safe_logs = '\\\\n",
        "'.join(recent_logs[-20:])\n        raise RuntimeError(\n            'O Cloudflare Named Tunnel encerrou durante a inicialização. '\n            'Veja as últimas mensagens do cloudflared abaixo; o token foi mantido oculto.\\\\n",
        "\\\\n",
        "'\n            + (safe_logs or 'O processo encerrou sem produzir mensagens. Confira se CLOUDFLARE_TUNNEL_TOKEN é o token de instalação do Named Tunnel.')\n        )\n    startup_logs = []\n    while not tunnel_lines.empty():\n        startup_logs.append(tunnel_lines.get_nowait())\n    if startup_logs:\n        print('Cloudflare:', startup_logs[-1])\n\n# Disponibiliza a URL também como variável de ambiente durante esta sessão.\nos.environ['JOE_API_URL'] = API_URL\n\ndisplay(Markdown(\n    '## Joe API pronta\\n",
        "\\n",
        "'\n    f'**URL da API:** `{API_URL}`\\n",
        "\\n",
        "'\n    + (\n        '**Token Bearer:** carregado de Colab Secrets (`JOE_API_TOKEN`). '\n        'Use esse valor na aba Google Colab / API do Joe apenas na primeira configuração.\\n",
        "\\n",
        "'\n        if not GENERATED_API_TOKEN else\n        f'**Token Bearer:** `{API_TOKEN}`\\n",
        "\\n",
        "'\n        '**Atenção:** este token foi gerado apenas para esta sessão. Para mantê-lo, '\n        'adicione-o ao Secret `JOE_API_TOKEN` antes da próxima sessão.\\n",
        "\\n",
        "'\n    )\n    + (\n        '**Conexão persistente:** o domínio e o token Bearer foram carregados dos Secrets. '\n        'O Joe pode manter a mesma configuração entre sessões.\\n",
        "\\n",
        "'\n        if JOE_TUNNEL_MODE == 'custom' and not GENERATED_API_TOKEN else\n        '**Conexão temporária:** o Quick Tunnel gera outra URL quando o runtime reiniciar. '\n        'Atualize a URL no Joe após cada nova sessão.\\n",
        "\\n",
        "'\n        if JOE_TUNNEL_MODE == 'quick' else\n        '**Atenção:** a URL é fixa, mas salve o token Bearer no Secret `JOE_API_TOKEN` '\n        'para que ele também permaneça igual nas próximas sessões.\\n",
        "\\n",
        "'\n    )\n    + 'Não compartilhe a saída desta célula.'\n))\n"
      ]
