        "    os.environ[\"CLOUDFLARE_TUNNEL_TOKEN\"] = SAVED_TUNNEL_TOKEN\n",
        "    JOE_TUNNEL_MODE = \"custom\"\n",
        "    JOE_TUNNEL_DOMAIN = SAVED_TUNNEL_DOMAIN\n",
        "    JOE_TUNNEL_TOKEN = SAVED_TUNNEL_TOKEN\n",
        "else:\n",
        "    os.environ.pop(\"JOE_API_URL\", None)\n",
        "    os.environ.pop(\"CLOUDFLARE_TUNNEL_TOKEN\", None)\n",
        "    JOE_TUNNEL_MODE = \"quick\"\n",
        "    JOE_TUNNEL_DOMAIN = \"\"\n",
        "    JOE_TUNNEL_TOKEN = \"\"\n",
        "\n",
        "missing_secrets = [\n",
        "    name\n",
        "    for name, value in (\n",
        "        (\"JOE_API_URL\", SAVED_TUNNEL_DOMAIN),\n",
        "        (\"JOE_API_TOKEN\", SAVED_API_TOKEN),\n",
        "        (\"CLOUDFLARE_TUNNEL_TOKEN\", SAVED_TUNNEL_TOKEN),\n",
        "    )\n",
        "    if not value\n",
        "]\n",
        "if not missing_secrets:\n",
        "    print(\"Secrets persistentes carregados. O notebook usará o domínio fixo e o mesmo token Bearer.\")\n",
        "else:\n",
        "    print(\"Secrets ainda não configurados ou sem acesso: \" + \", \".join(missing_secrets))\n",
        "    print(\"Abra o painel Secrets (ícone de chave), confirme os nomes e habilite Notebook access.\")\n",
        "    print(\"A conexão persistente exige os três Secrets. O Quick Tunnel continua disponível como alternativa temporária.\")\n",
        "\n",
        "tunnel_mode_widget = widgets.Dropdown(\n",
        "    options=[\n",
