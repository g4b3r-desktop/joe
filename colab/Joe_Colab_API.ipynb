        "## Google Drive: sincronizar e carregar os modelos\n\nO Pocket TTS usa o ZIP `Meu Drive/3d_models_ia/modelos-voz/JOE_MODELS.zip`. Ao clicar em **Aplicar pastas e modelos**, o notebook verifica os arquivos necessários das duas variantes portuguesas.\n\n- **Portuguese padrão:** checkpoint e tokenizer próprios.\n- **Portuguese 24L:** checkpoint e tokenizer próprios, compatíveis com estados de voz preparados para a variante de 24 camadas.\n- Se algum arquivo estiver ausente ou inválido no ZIP, somente esse arquivo será baixado do Hugging Face e incluído no ZIP do Drive.\n- Se o ZIP ainda não existir, será criado automaticamente.\n- O ZIP atualizado nunca poderá ultrapassar **4 GiB**. Se ultrapassaria o limite, o arquivo original no Drive será preservado.\n- O ZIP é extraído para `/content/joe/models/`; o Pocket TTS carrega os checkpoints extraídos, não diretamente de dentro do ZIP.\n\n### Acesso ao Hugging Face (necessário somente quando faltar algum arquivo)\n\nO repositório oficial exige aceitar as condições de acesso. Antes da primeira transferência:\n\n1. Entre em [kyutai/pocket-tts](https://huggingface.co/kyutai/pocket-tts) e aceite as condições de uso.\n2. Crie um token Hugging Face com permissão de leitura.\n3. No painel **Secrets** do Colab (ícone de chave), crie `HF_TOKEN` e habilite **Notebook access**.\n\nO token é usado somente no runtime para baixar os arquivos. Não é gravado no ZIP, no Drive ou no notebook e não é impresso. Se todos os arquivos necessários já estiverem válidos no ZIP, o notebook não fará downloads nem exigirá o token.\n\nEstrutura sincronizada automaticamente (diretamente na raiz ou dentro de `JOE_MODELS/`):\n\n```text\nJOE_MODELS/\n├── pocket-tts/\n│   └── languages/\n│       ├── portuguese/model.safetensors\n│       └── portuguese_24l/model.safetensors\n└── pocket-tts-without-voice-cloning/\n    └── languages/\n        ├── portuguese/tokenizer.json\n        └── portuguese_24l/tokenizer.json\n```\n\nO campo **Voz padrão WAV** continua opcional quando o Joe envia a própria referência. Para estados de voz `.safetensors`, selecione a mesma variante de modelo que foi usada para preparar o estado: `portuguese` ou `portuguese_24l`.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "#@title Montar o Google Drive e configurar os modelos de voz\nimport os\nimport shutil\nimport sys\nimport zipfile\nfrom pathlib import Path\n\nimport ipywidgets as widgets\nimport yaml\nfrom google.colab import drive, userdata\nfrom IPython.display import display, clear_output\n\ndrive.mount('/content/drive')\n\n# Reutiliza a rotina versionada no próprio repositório do Joe.\nCOLAB_CODE_DIR = Path('/content/joe/colab')\nif str(COLAB_CODE_DIR) not in sys.path:\n    sys.path.insert(0, str(COLAB_CODE_DIR))\nfrom drive_model_sync import (\n    MAX_ARCHIVE_BYTES,\n    ensure_portuguese_model_in_zip,\n)\n\n\ndef _read_hf_token():\n    try:\n        value = userdata.get('HF_TOKEN')\n        return str(value).strip() if value else None\n    except Exception:\n        # O token só é obrigatório quando o ZIP não contém algum arquivo do modelo.\n        return None\n\nDEFAULT_ZIP_PATH = Path('/content/drive/MyDrive/3d_models_ia/modelos-voz/JOE_MODELS.zip')\nEXTRACT_BASE = Path('/content/joe/models')\n\nzip_widget = widgets.Text(\n    value=str(DEFAULT_ZIP_PATH),\n    description='Arquivo ZIP:',\n    layout=widgets.Layout(width='95%'),\n)\nmodel_folder_widget = widgets.Text(\n    value=str(EXTRACT_BASE / 'JOE_MODELS' / 'pocket-tts'),\n    description='Pasta Pocket TTS:',\n    layout=widgets.Layout(width='95%'),\n)\ntokenizer_widget = widgets.Text(\n    value=str(EXTRACT_BASE / 'JOE_MODELS' / 'pocket-tts-without-voice-cloning' / 'languages' / 'portuguese' / 'tokenizer.json'),\n    description='Tokenizer JSON:',\n    layout=widgets.Layout(width='95%'),\n)\nvoice_widget = widgets.Text(\n    value='',\n    placeholder='Obrigatório se o Joe não enviar um WAV: caminho de um WAV no Drive',\n    description='Voz padrão WAV:',\n    layout=widgets.Layout(width='95%'),\n)\nhf_cache_widget = widgets.Text(\n    value=str(Path('/content/drive/MyDrive/3d_models_ia/huggingface-cache')),\n    description='Cache ASR:',\n    layout=widgets.Layout(width='95%'),\n)\nuse_drive_tts_widget = widgets.Checkbox(\n    value=True,\n    description='Obrigatório: carregar Pocket TTS do Google Drive',\n)\napply_paths_button = widgets.Button(\n    description='Aplicar pastas e modelos',\n    button_style='success',\n    icon='check',\n)\npaths_output = widgets.Output()\n\n\ndef _extract_models_zip(zip_path: Path) -> Path:\n    if not zip_path.is_file():\n        raise FileNotFoundError(f'Arquivo ZIP não encontrado: {zip_path}')\n\n    # Reutiliza extração válida na mesma sessão do Colab.\n    for candidate in (EXTRACT_BASE / 'JOE_MODELS', EXTRACT_BASE):\n        required_files = (\n            candidate / 'pocket-tts' / 'languages' / 'portuguese' / 'model.safetensors',\n            candidate / 'pocket-tts' / 'languages' / 'portuguese_24l' / 'model.safetensors',\n            candidate / 'pocket-tts-without-voice-cloning' / 'languages' / 'portuguese' / 'tokenizer.json',\n            candidate / 'pocket-tts-without-voice-cloning' / 'languages' / 'portuguese_24l' / 'tokenizer.json',\n        )\n        if all(path.is_file() for path in required_files):\n            return candidate\n\n    EXTRACT_BASE.mkdir(parents=True, exist_ok=True)\n    with zipfile.ZipFile(zip_path) as archive:\n        base_resolved = EXTRACT_BASE.resolve()\n        for member in archive.infolist():\n            target = (EXTRACT_BASE / member.filename).resolve()\n            if not target.is_relative_to(base_resolved):\n                raise ValueError(f'Caminho inseguro dentro do ZIP: {member.filename}')\n        archive.extractall(EXTRACT_BASE)\n\n    for candidate in (EXTRACT_BASE / 'JOE_MODELS', EXTRACT_BASE):\n        if (candidate / 'pocket-tts').is_dir():\n            return candidate\n    raise FileNotFoundError(\n        'Não encontrei pocket-tts/ dentro do ZIP. Confira a estrutura do JOE_MODELS.zip.'\n    )\n\n\ndef apply_drive_model_paths(_=None):\n    with paths_output:\n        clear_output()\n        for key in (\n            'JOE_TTS_CONFIG_PATH',\n            'JOE_TTS_24L_CONFIG_PATH',\n            'JOE_TTS_DEFAULT_VOICE',\n            'JOE_TTS_USE_DRIVE_MODELS',\n        ):\n            os.environ.pop(key, None)\n\n        try:\n            if not use_drive_tts_widget.value:\n                raise RuntimeError(\n                    'Este notebook foi configurado para usar os modelos do Drive. '\n                    'Marque a opção de carregamento pelo Drive.'\n                )\n\n            zip_path = Path(zip_widget.value.strip()).expanduser()\n\n            # Sincroniza apenas o que estiver ausente ou inválido no ZIP do Drive.\n            sync_result = ensure_portuguese_model_in_zip(\n                zip_path,\n                token=_read_hf_token(),\n                max_archive_bytes=MAX_ARCHIVE_BYTES,\n            )\n            size_gib = sync_result['archive_size_bytes'] / (1024 ** 3)\n            if sync_result['downloaded']:\n                print('ZIP do Drive atualizado:', zip_path)\n                print('Arquivos adicionados:')\n                for member in sync_result['downloaded']:\n                    print('  +', member)\n            else:\n                print('Modelo e tokenizer já estão válidos no ZIP; nenhum download necessário.')\n            print(f'Tamanho do ZIP: {size_gib:.2f} GiB / 4.00 GiB')\n\n            # Se o ZIP mudou, descarta a extração anterior para não usar pesos antigos.\n            if sync_result['updated'] and EXTRACT_BASE.exists():\n                shutil.rmtree(EXTRACT_BASE)\n            extracted_root = _extract_models_zip(zip_path)\n            model_root = Path(model_folder_widget.value.strip()).expanduser()\n            if not model_root.is_dir() or model_root == EXTRACT_BASE / 'JOE_MODELS' / 'pocket-tts':\n                model_root = extracted_root / 'pocket-tts'\n                model_folder_widget.value = str(model_root)\n\n            clone_weights = model_root / 'languages' / 'portuguese' / 'model.safetensors'\n            clone_weights_24l = (\n                model_root / 'languages' / 'portuguese_24l' / 'model.safetensors'\n            )\n            no_clone_weights = (\n                extracted_root / 'pocket-tts-without-voice-cloning'\n                / 'languages' / 'portuguese' / 'model.safetensors'\n            )\n            no_clone_weights_24l = (\n                extracted_root / 'pocket-tts-without-voice-cloning'\n                / 'languages' / 'portuguese_24l' / 'model.safetensors'\n            )\n            tokenizer_file_24l = (\n                extracted_root / 'pocket-tts-without-voice-cloning'\n                / 'languages' / 'portuguese_24l' / 'tokenizer.json'\n            )\n            # O ZIP pode conter pastas extras ou nomes de diretório diferentes.\n            # Primeiro respeita o caminho informado; depois procura na árvore extraída.\n            tokenizer_file = Path(tokenizer_widget.value.strip()).expanduser()\n            if not tokenizer_file.is_file():\n                candidates = list(extracted_root.rglob('tokenizer.json'))\n                portuguese_candidates = [\n                    p for p in candidates if 'portuguese' in str(p).lower()\n                ]\n                preferred_candidates = [\n                    p for p in portuguese_candidates\n                    if 'without-voice-cloning' in str(p).lower()\n                ]\n                search_candidates = preferred_candidates or portuguese_candidates or candidates\n                if len(search_candidates) == 1:\n                    tokenizer_file = search_candidates[0]\n                elif len(search_candidates) > 1:\n                    raise FileNotFoundError(\n                        'Encontrei vários tokenizer.json. Informe o caminho correto no campo Tokenizer JSON:\\\\n",
        "'\n                        + '\\\\n",
        "'.join(str(p) for p in search_candidates)\n                    )\n                else:\n                    raise FileNotFoundError(\n                        'Não encontrei tokenizer.json dentro do ZIP extraído. '\n                        'Confira se o arquivo foi incluído no JOE_MODELS.zip.'\n                    )\n                tokenizer_widget.value = str(tokenizer_file)\n\n            missing = [\n                str(path)\n                for path in (\n                    clone_weights,\n                    tokenizer_file,\n                    clone_weights_24l,\n                    tokenizer_file_24l,\n                )\n                if not path.is_file()\n            ]\n            if missing:\n                raise FileNotFoundError(\n                    'Faltam arquivos obrigatórios no ZIP do Drive:\\\\n",
        "' + '\\\\n",
        "'.join(missing)\n                )\n\n            import pocket_tts\n            package_config_dir = Path(pocket_tts.__file__).resolve().parent / 'config'\n            package_config = package_config_dir / 'portuguese.yaml'\n            package_config_24l = package_config_dir / 'portuguese_24l.yaml'\n            for config_path in (package_config, package_config_24l):\n                if not config_path.is_file():\n                    raise FileNotFoundError(\n                        f'Configuração do Pocket TTS não encontrada: {config_path}'\n                    )\n\n            config_data = yaml.safe_load(package_config.read_text(encoding='utf-8'))\n            config_data['weights_path'] = str(clone_weights.resolve())\n            config_data['weights_path_without_voice_cloning'] = (\n                str(no_clone_weights.resolve()) if no_clone_weights.is_file() else None\n            )\n            config_data['flow_lm']['lookup_table']['tokenizer_path'] = str(tokenizer_file.resolve())\n\n            config_data_24l = yaml.safe_load(\n                package_config_24l.read_text(encoding='utf-8')\n            )\n            config_data_24l['weights_path'] = str(clone_weights_24l.resolve())\n            config_data_24l['weights_path_without_voice_cloning'] = (\n                str(no_clone_weights_24l.resolve())\n                if no_clone_weights_24l.is_file()\n                else None\n            )\n            config_data_24l['flow_lm']['lookup_table']['tokenizer_path'] = (\n                str(tokenizer_file_24l.resolve())\n            )\n\n            voice_value = voice_widget.value.strip()\n            if voice_value:\n                voice_file = Path(voice_value).expanduser()\n                if not voice_file.is_file():\n                    raise FileNotFoundError(f'WAV de voz padrão não encontrado: {voice_file}')\n                if voice_file.suffix.lower() != '.wav':\n                    raise ValueError('A voz padrão deve ser um arquivo WAV de referência.')\n            else:\n                voice_file = None\n\n            runtime_dir = Path('/content/joe/runtime')\n            runtime_dir.mkdir(parents=True, exist_ok=True)\n            local_config = runtime_dir / 'portuguese_from_drive.yaml'\n            local_config_24l = runtime_dir / 'portuguese_24l_from_drive.yaml'\n            local_config.write_text(\n                yaml.safe_dump(config_data, sort_keys=False, allow_unicode=True),\n                encoding='utf-8',\n            )\n            local_config_24l.write_text(\n                yaml.safe_dump(config_data_24l, sort_keys=False, allow_unicode=True),\n                encoding='utf-8',\n            )\n\n            # A API só inicia em modo Drive depois que ambas as variantes foram validadas.\n            os.environ['JOE_TTS_CONFIG_PATH'] = str(local_config)\n            os.environ['JOE_TTS_24L_CONFIG_PATH'] = str(local_config_24l)\n            os.environ['JOE_TTS_USE_DRIVE_MODELS'] = '1'\n            if voice_file:\n                os.environ['JOE_TTS_DEFAULT_VOICE'] = str(voice_file.resolve())\n\n            cache_dir = Path(hf_cache_widget.value.strip()).expanduser()\n            cache_dir.mkdir(parents=True, exist_ok=True)\n            os.environ['HF_HOME'] = str(cache_dir)\n\n            print(f'ZIP extraído em: {extracted_root}')\n            print(f'Pesos com clonagem (Drive): {clone_weights}')\n            print(\n                'Pesos sem clonagem (Drive): '\n                + (str(no_clone_weights) if no_clone_weights.is_file() else 'não incluídos')\n            )\n            print(f'Tokenizer padrão (Drive): {tokenizer_file}')\n            print(f'Pesos 24L com clonagem (Drive): {clone_weights_24l}')\n            print(f'Tokenizer 24L (Drive): {tokenizer_file_24l}')\n            print(f'WAV padrão: {voice_file if voice_file else \"não definido; o Joe deverá enviar um WAV\"}')\n            print(f'Configuração local padrão: {local_config}')\n            print(f'Configuração local 24L: {local_config_24l}')\n            print('Configuração validada: a API usará os pesos locais do Drive.')\n        except Exception as exc:\n            print(f'ERRO ao configurar os modelos do Drive: {exc}')\n            print('A API não deve ser iniciada até corrigir os caminhos/arquivos do ZIP.')\n\n\napply_paths_button.on_click(apply_drive_model_paths)\ndisplay(widgets.VBox([\n    use_drive_tts_widget,\n    zip_widget,\n    model_folder_widget,\n    tokenizer_widget,\n    voice_widget,\n    hf_cache_widget,\n    apply_paths_button,\n    paths_output,\n]))\napply_drive_model_paths()\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Escolher o endereço do túnel Cloudflare\n",
        "\n",
        "Quando os três Secrets `JOE_API_URL`, `JOE_API_TOKEN` e `CLOUDFLARE_TUNNEL_TOKEN` estiverem configurados e com **Notebook access** habilitado, o modo **domínio fixo** será selecionado automaticamente. A URL pode ser informada como `api.seudominio.com` ou `https://api.seudominio.com`. Os campos abaixo também permitem configurar um Named Tunnel apenas para esta sessão.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "#@title Carregar Secrets e configurar o Cloudflare Tunnel\n",
        "import os\n",
        "import re\n",
        "from urllib.parse import urlsplit\n",
        "\n",
        "import ipywidgets as widgets\n",
        "from google.colab import userdata\n",
        "from IPython.display import display\n",
        "\n",
        "\n",
        "def _read_colab_secret(name):\n",
        "    try:\n",
        "        value = userdata.get(name)\n",
        "        return str(value).strip() if value is not None else \"\"\n",
        "    except Exception:\n",
        "        # Secret ausente ou Notebook access ainda não habilitado.\n",
        "        return \"\"\n",
        "\n",
        "\n",
        "def _domain_from_api_url(value):\n",
        "    \"\"\"Retorna apenas um hostname HTTPS válido, aceitando URL ou domínio puro.\"\"\"\n",
        "    raw_value = str(value or \"\").strip()\n",
        "    if not raw_value or re.search(r\"\\s\", raw_value):\n",
        "        return \"\"\n",
        "\n",
        "    # O Secret pode conter api.exemplo.com ou https://api.exemplo.com.\n",
        "    url_to_parse = raw_value\n",
        "    if not url_to_parse.lower().startswith((\"http://\", \"https://\")):\n",
        "        url_to_parse = \"https://\" + url_to_parse\n",
        "\n",
        "    try:\n",
        "        parsed = urlsplit(url_to_parse)\n",
        "        hostname = parsed.hostname\n",
        "        port = parsed.port\n",
        "    except ValueError:\n",
        "        return \"\"\n",
        "\n",
        "    if (\n",
        "        parsed.scheme.lower() != \"https\"\n",
        "        or not hostname\n",
        "        or parsed.username is not None\n",
        "        or parsed.password is not None\n",
        "        or parsed.path not in (\"\", \"/\")\n",
        "        or parsed.query\n",
        "        or parsed.fragment\n",
        "        or port is not None\n",
        "    ):\n",
        "        return \"\"\n",
        "\n",
        "    hostname = hostname.lower().rstrip(\".\")\n",
        "    domain_pattern = r\"(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,}\"\n",
        "    if not re.fullmatch(domain_pattern, hostname):\n",
        "        return \"\"\n",
        "    return hostname\n",
        "\n",
        "\n",
        "# Os Secrets ficam guardados no painel do Colab e são carregados no ambiente\n",
        "# desta sessão. Não coloque os valores diretamente no notebook.\n",
        "SAVED_API_URL = _read_colab_secret(\"JOE_API_URL\")\n",
        "if SAVED_API_URL and not SAVED_API_URL.lower().startswith((\"http://\", \"https://\")):\n",
        "    SAVED_API_URL = \"https://\" + SAVED_API_URL\n",
        "\n",
        "SAVED_API_TOKEN = _read_colab_secret(\"JOE_API_TOKEN\")\n",
        "SAVED_TUNNEL_TOKEN = _read_colab_secret(\"CLOUDFLARE_TUNNEL_TOKEN\")\n",
        "\n",
        "SAVED_TUNNEL_DOMAIN = _domain_from_api_url(SAVED_API_URL)\n",
        "if SAVED_API_TOKEN:\n",
        "    os.environ[\"JOE_API_TOKEN\"] = SAVED_API_TOKEN\n",
        "else:\n",
        "    os.environ.pop(\"JOE_API_TOKEN\", None)\n",
        "\n",
        "# Seleciona o Named Tunnel automaticamente somente quando os três Secrets\n",
        "# necessários para uma conexão persistente estiverem disponíveis.\n",
