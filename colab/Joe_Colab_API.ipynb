        "    placeholder=\"api.seudominio.com\",\n",
        "    description=\"Domínio:\",\n",
        "    layout=widgets.Layout(width=\"95%\"),\n",
        ")\n",
        "tunnel_token_widget = widgets.Password(\n",
        "    value=JOE_TUNNEL_TOKEN,\n",
        "    placeholder=\"Token do Cloudflare Named Tunnel\",\n",
        "    description=\"Token túnel:\",\n",
        "    layout=widgets.Layout(width=\"95%\"),\n",
        ")\n",
        "tunnel_config_button = widgets.Button(\n",
        "    description=\"Aplicar configuração do túnel\",\n",
        "    button_style=\"success\",\n",
        "    icon=\"check\",\n",
        ")\n",
        "tunnel_config_output = widgets.Output()\n",
        "\n",
        "\n",
        "def apply_tunnel_config(_):\n",
        "    global JOE_TUNNEL_MODE, JOE_TUNNEL_DOMAIN, JOE_TUNNEL_TOKEN\n",
        "\n",
        "    with tunnel_config_output:\n",
        "        tunnel_config_output.clear_output()\n",
        "        mode = tunnel_mode_widget.value\n",
        "        domain = tunnel_domain_widget.value.strip().lower().rstrip(\".\")\n",
        "        token = tunnel_token_widget.value.strip()\n",
        "\n",
        "        if mode == \"custom\":\n",
        "            domain_pattern = r\"(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,}\"\n",
        "            if not re.fullmatch(domain_pattern, domain):\n",
        "                print(\"Informe somente um domínio válido, como api.seudominio.com.\")\n",
        "                return\n",
        "            if not token:\n",
        "                print(\"Cole o token do Cloudflare Named Tunnel. Ele não será exibido.\")\n",
        "                return\n",
        "\n",
        "            JOE_TUNNEL_MODE = \"custom\"\n",
        "            JOE_TUNNEL_DOMAIN = domain\n",
        "            JOE_TUNNEL_TOKEN = token\n",
        "            os.environ[\"JOE_API_URL\"] = f\"https://{domain}\"\n",
        "            os.environ[\"CLOUDFLARE_TUNNEL_TOKEN\"] = token\n",
        "            print(\"Named Tunnel configurado para esta sessão:\", os.environ[\"JOE_API_URL\"])\n",
